{
  "name": "atocha",
  "version": "4.0.0",
  "description": "Tiny exec() with Promises and trim()",
  "repository": "github:franciscop/atocha",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "exec",
    "console",
    "terminal",
    "promise",
    "promises",
    "async",
    "await",
    "cli"
  ],
  "scripts": {
    "build": "npm run build:bundle && npm run build:types && npm run build:prettier",
    "build:bundle": "bun build src/index.ts --outfile=index.min.js --minify --format=esm --target=node",
    "build:types": "dts-bundle-generator --out-file index.d.ts --project tsconfig.json src/index.ts",
    "build:prettier": "prettier --write src *.ts *.json",
    "lint": "oxlint src && tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "bun test --watch",
    "test": "bun test"
  },
  "main": "index.min.js",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.min.js",
    "index.d.ts"
  ],
  "dependencies": {
    "swear": "^2.0.1"
  },
  "devDependencies": {
    "@endosome/dts-bundle-generator": "9.6.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
